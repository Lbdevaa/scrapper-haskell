cabal-version:      2.4
name:               scrapper-haskell
version:            0.1.0.0
synopsis:           Выгрузка каталога vprok.ru: снапшоты, отчёты, история цен, diff
build-type:         Simple

executable scrapper
    main-is:          Main.hs
    hs-source-dirs:   app, src
    other-modules:    Vprok.Api
                      Vprok.Csv
                      Vprok.Diff
                      Vprok.Report
                      Vprok.Snapshot
                      Vprok.Types
    build-depends:    base                 >=4.16 && <5
                    , aeson                >=2.0
                    , bytestring
                    , containers
                    , directory
                    , filepath
                    , http-client
                    , http-client-tls
                    , http-types
                    , optparse-applicative
                    , text
                    , time
    default-language: Haskell2010
    ghc-options:      -Wall
